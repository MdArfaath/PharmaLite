# ---------------------------------------------------------------------
# Supabase — copy to .env.local and fill in from your Supabase project
# (Project Settings → API). PROJECT.md §16: only the anon key is public.
# ---------------------------------------------------------------------

# Public (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only (NEVER prefix with NEXT_PUBLIC_). Used only by lib/supabase/admin.ts
# for privileged tasks. Not required for the Auth + App Shell module.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
